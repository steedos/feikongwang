PORT=5100
ROOT_URL=http://127.0.0.1:5100
TRANSPORTER=redis://127.0.0.1:6379
CACHER=redis://127.0.0.1:6379/1
MONGO_URL=mongodb://127.0.0.1:27017/feikongwang

B6_LOG_LEVEL=info
B6_MO_LOG_LEVEL=warn

STEEDOS_CRON_ENABLED=true

# 用户名最小长度
STEEDOS_ACCOUNT_USERNAME_MIN_LENGTH=3

# 未登录时跳转到登录页面
STEEDOS_TENANT_PAGE_LOGIN=

# 流程对象同步
STEEDOS_CRON_ENABLED=true
STEEDOS_CRON_INSTANCERECORDQUEUE_INTERVAL=1000

DEVELOPER_STANDARD_OBJECTS=true

# 启用SaaS模式，SaaS运行模式下，禁止安装软件包、创建自定义对象。
STEEDOS_TENANT_ENABLE_SAAS=false

# 百度发票识别、验真（@steedos-labs/invoice）
STEEDOS_LABS_INVOICE_BAIDU_AK=
STEEDOS_LABS_INVOICE_BAIDU_SK=

STEEDOS_ENABLE_WORKFLOW=true

# OpenID Connect
B6_OIDC_ENABLED=false
B6_OIDC_CONFIG_URL=https://id.steedos.cn/realms/master/.well-known/openid-configuration
B6_OIDC_CLIENT_ID=feikongwang.com
B6_OIDC_CLIENT_SECRET=none
B6_OIDC_NAME=Steedos ID
B6_OIDC_LOGO=
B6_OIDC_REQUIRE_LOCAL_ACCOUNT=false